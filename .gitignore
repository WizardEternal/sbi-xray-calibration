data/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/
sbi-logs/

# Heavy / regenerable artifacts: checkpoints, datasets, and raw benchmark dumps
# are not committed (all rebuildable from config + seed). Final README/RESULTS
# figures are the exception and are committed below via negations.
*.h5
*.pt
*.pkl
*.ckpt

# trained-flow checkpoints + their metadata (regenerable; some are large)
outputs/models/

# per-level calibration dumps (npz/json/most png) -- regenerable
outputs/calibration/

# detection-benchmark scores/AUC JSONL + working figures -- regenerable
outputs/detect/

# NS-vs-NPE benchmark JSONL + analysis -- regenerable
outputs/ns_bench/

# GO/NO-GO robustness pack: per-variant calibration dumps + figures -- regenerable
# (the summary.jsonl record is committed below, like the detect markdown tables)
outputs/gonogo/

# Final figures and tables to commit (un-ignored); everything heavy above stays
# ignored. Each negation re-includes one file from an otherwise-ignored
# directory -- git can only descend into the directory once a path under it
# has been negated, so the directory itself is re-included first.

# the money plot (top-level outputs/, not under any ignored subdir)
!outputs/money_plot.png

# trained-flow metadata: the three production flows' summary.json (the
# committed record behind the README's train/val-loss-gap and epoch-cap
# numbers) is small and committed too; every other model directory (gonogo
# variants, NICER flows) and the production checkpoints/losses/configs stay out
!outputs/models/
outputs/models/*
!outputs/models/train_npe_prod_*/
outputs/models/train_npe_prod_*/*
!outputs/models/train_npe_prod_*/summary.json

# calibration figures + the per-level summary.json (the committed record
# behind the calibration table); the tarp.npz (the record behind the README's
# TARP abs-area / ATC / max|ECP-alpha| numbers) is small and committed too;
# the rest of the npz stay ignored
!outputs/calibration/
!outputs/calibration/*/
outputs/calibration/*/*
!outputs/calibration/*/sbc_ranks.png
!outputs/calibration/*/tarp.png
!outputs/calibration/*/coverage_before_after.png
!outputs/calibration/*/summary.json
!outputs/calibration/*/tarp.npz

# detection figures, the AUC / consequence tables, and the per-cell
# results.jsonl (the verifiable record behind the README numbers); per-spectrum
# scores stay out
!outputs/detect/
outputs/detect/*
!outputs/detect/auc_table.md
!outputs/detect/consequence.md
!outputs/detect/results.jsonl
# the record behind consequence.md and diagnostics/dgamma_silent_failure.png
!outputs/detect/consequence.jsonl

# GO/NO-GO robustness pack: the one-line-per-variant verdict record (the
# evidence behind the ROBUST/FRAGILE/MIXED call) is committed; each variant's
# sbc.npz (the record behind the README's per-param SBC fail counts) is small
# and committed too; the rest of the per-variant calibration dumps/figures
# stay ignored
!outputs/gonogo/
outputs/gonogo/*
!outputs/gonogo/summary.jsonl
!outputs/gonogo/*/
outputs/gonogo/*/*
!outputs/gonogo/*/sbc.npz

# NS-vs-NPE benchmark: commit the digested analysis (analysis.md +
# analysis_summary.json), the count-controlled evidence summary, the paired
# gain check, and the per-spectrum log-evidence (the evidence record behind the
# README's NS table); raw backups/probes/timing logs stay out
!outputs/ns_bench/
outputs/ns_bench/*
!outputs/ns_bench/analysis.md
!outputs/ns_bench/analysis_summary.json
!outputs/ns_bench/count_controlled.json
!outputs/ns_bench/paired_gain_check.jsonl
!outputs/ns_bench/results.jsonl

# diagnostics figures + tables used in the README (money-panel, detector grid,
# dGamma, recovery scatters, learning curve, de-risk checks, TARP curve, the
# validation summary + learning-curve json); re-include the directory, ignore
# all its contents (so stray dumps like a stdout log stay out), then re-include
# only the specific committed files
!outputs/diagnostics/
outputs/diagnostics/*
!outputs/diagnostics/coverage_money_panel.png
!outputs/diagnostics/detector_auc_grid.png
!outputs/diagnostics/dgamma_silent_failure.png
!outputs/diagnostics/learning_curve_dev.json
!outputs/diagnostics/learning_curve_dev.png
!outputs/diagnostics/npe_recovery_bright.png
!outputs/diagnostics/npe_recovery_faint.png
!outputs/diagnostics/npe_recovery_medium.png
!outputs/diagnostics/tarp_bright_curve.png
!outputs/diagnostics/validation_prod_summary.json
!outputs/diagnostics/nicer_replication.png
!outputs/diagnostics/nicer_sbc.png

# ignored: contains absolute local paths
outputs/diagnostics/validation_prod_stdout.txt

# NICER benchmark outputs: commit the small evidence files behind the README's
# NICER numbers (the detection results.jsonl + the per-level calibration
# summary.json); heavy dumps stay out and are regenerated by the pipeline.
# ns_bench_nicer stays fully ignored.
outputs/detect_nicer/*
!outputs/detect_nicer/results.jsonl
outputs/calibration_nicer/**
!outputs/calibration_nicer/**/
!outputs/calibration_nicer/**/summary.json
outputs/ns_bench_nicer/
