data/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/
sbi-logs/

# Checkpoints, datasets and raw benchmark dumps are not committed; all of them
# rebuild from config + seed. The figures and small summary files the README
# quotes are the exception and are un-ignored below.
*.h5
*.pt
*.pkl
*.ckpt

outputs/models/
outputs/calibration/
outputs/detect/
outputs/ns_bench/
outputs/reseed/

# Un-ignored files. git can only descend into an ignored directory once a path
# under it has been negated, so each block re-includes the directory, re-ignores
# its contents, then names the files that are committed.

!outputs/summary_figure.png

# the three production flows' summary.json (loss curves, epochs trained)
!outputs/models/
outputs/models/*
!outputs/models/train_npe_prod_*/
outputs/models/train_npe_prod_*/*
!outputs/models/train_npe_prod_*/summary.json

# calibration figures, per-level summary.json, and tarp.npz (the TARP curve is
# read back for the abs-area / ATC / max|ECP-alpha| numbers)
!outputs/calibration/
!outputs/calibration/*/
outputs/calibration/*/*
!outputs/calibration/*/sbc_ranks.png
!outputs/calibration/*/tarp.png
!outputs/calibration/*/coverage_before_after.png
!outputs/calibration/*/summary.json
!outputs/calibration/*/tarp.npz

# detection tables and per-cell results; per-spectrum scores stay out
!outputs/detect/
outputs/detect/*
!outputs/detect/auc_table.md
!outputs/detect/consequence.md
!outputs/detect/results.jsonl
!outputs/detect/consequence.jsonl

# reseed pack: the one-line-per-variant summary and each variant's sbc.npz
!outputs/reseed/
outputs/reseed/*
!outputs/reseed/summary.jsonl
!outputs/reseed/*/
outputs/reseed/*/*
!outputs/reseed/*/sbc.npz

# NS-vs-NPE benchmark: the digested analysis, the count-controlled evidence
# summary, the paired gain check, the per-spectrum log-evidence, and the
# thread-wise bootstrap results. The bootstrap's run directories are heavy and
# stay out.
!outputs/ns_bench/
outputs/ns_bench/*
!outputs/ns_bench/analysis.md
!outputs/ns_bench/analysis_summary.json
!outputs/ns_bench/count_controlled.json
!outputs/ns_bench/paired_gain_check.jsonl
!outputs/ns_bench/results.jsonl
!outputs/ns_bench/higson/
outputs/ns_bench/higson/*
!outputs/ns_bench/higson/higson_results.json
!outputs/ns_bench/higson/higson_table.md
!outputs/ns_bench/higson/higson_recompute.jsonl
!outputs/ns_bench/higson/higson_mc_noise.jsonl

# diagnostics figures and tables used in the README
!outputs/diagnostics/
outputs/diagnostics/*
!outputs/diagnostics/coverage_panel.png
!outputs/diagnostics/detector_auc_grid.png
!outputs/diagnostics/dgamma_silent_failure.png
!outputs/diagnostics/learning_curve_dev.json
!outputs/diagnostics/learning_curve_dev.png
!outputs/diagnostics/npe_recovery_bright.png
!outputs/diagnostics/npe_recovery_faint.png
!outputs/diagnostics/npe_recovery_medium.png
!outputs/diagnostics/tarp_bright_curve.png
!outputs/diagnostics/validation_prod_summary.json
!outputs/diagnostics/nicer_replication.png
!outputs/diagnostics/nicer_sbc.png

# ignored: contains absolute local paths
outputs/diagnostics/validation_prod_stdout.txt

# NICER: the detection results.jsonl and the per-level calibration summary.json.
# Heavy dumps stay out and are regenerated by the pipeline; ns_bench_nicer is
# fully ignored.
outputs/detect_nicer/*
!outputs/detect_nicer/results.jsonl
outputs/calibration_nicer/**
!outputs/calibration_nicer/**/
!outputs/calibration_nicer/**/summary.json
outputs/ns_bench_nicer/
